{
  "generator": "behavior_families",
  "max_depth": 8,
  "max_activities": 30,
  "max_arity": 3,
  "curriculum_phase": 3,
  "leaf_probability": 0.55,
  "motif_context_size": 6,
  "min_tree_depth": 4,
  "min_tree_size": 20,
  "motifs": {
    "ordinary_tree": 0.55,
    "duplicate_vs_silent": 0.15,
    "concurrent_vs_interleaved": 0.15,
    "m_nonfreechoice": 0.15
  },
  "class_coverage": {
    "mode": "strict",
    "min_families_per_motif": {
      "training": 8,
      "validation": 4,
      "test": 4
    }
  },
  "representations": {
    "variants_per_behavior": 2,
    "exact_equivalence_only_for_training": false
  },
  "logs": {
    "log_views_per_behavior": 1,
    "traces_per_log": 128,
    "sampling_modes": [
      "uniform_variants",
      "resampled"
    ]
  },
  "noise": {
    "clean_fraction": 0.2,
    "edit_count_weights": {
      "1": 0.5,
      "2": 0.3,
      "3": 0.2
    },
    "operation_weights": {
      "delete": 0.15,
      "insert": 0.15,
      "substitute": 0.15,
      "swap": 0.15,
      "repeat": 0.15,
      "prefix_truncate": 0.1,
      "suffix_truncate": 0.1,
      "outside_insert": 0.05
    }
  },
  "validation": {
    "exact_language_max_states": 5000,
    "exact_language_max_traces": 10000,
    "bounded_visible_length": 32
  },
  "min_activities": 8
}
