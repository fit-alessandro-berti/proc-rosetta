{
  "generator": "behavior_families",
  "max_depth": 7,
  "activity_vocab_size": 30,
  "max_generated_activities": 28,
  "max_arity": 3,
  "curriculum_phase": 3,
  "leaf_probability": 0.55,
  "operator_probabilities": {
    "seq": 0.25,
    "xor": 0.25,
    "and": 0.25,
    "loop": 0.25
  },
  "root_operator_probabilities": {
    "seq": 0.7,
    "xor": 0.1,
    "and": 0.1,
    "loop": 0.1
  },
  "motif_context_min_nodes": 4,
  "motif_context_max_nodes": 12,
  "min_tree_depth": 4,
  "min_tree_size": 20,
  "max_tree_size": 80,
  "complexity_level": "complex",
  "motifs": {
    "ordinary_tree": 0.75,
    "duplicate_vs_silent": 0.0833333333,
    "concurrent_vs_interleaved": 0.0833333333,
    "m_nonfreechoice": 0.0833333334
  },
  "class_coverage": {
