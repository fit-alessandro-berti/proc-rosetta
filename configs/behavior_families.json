    "edit_count_weights": {
      "1": 0.5,
      "2": 0.3,
      "3": 0.2
    },
    "operation_weights": {
      "delete": 0.15,
      "insert": 0.15,
      "substitute": 0.15,
      "swap": 0.15,
      "repeat": 0.15,
      "prefix_truncate": 0.1,
      "suffix_truncate": 0.1,
      "outside_insert": 0.05
    }
  },
  "validation": {
    "exact_language_max_states": 5000,
    "exact_language_max_traces": 10000,
    "bounded_visible_length": 32
  },
  "min_activities": 8
